# Copy to .env and change the values. .env is git-ignored.
POSTGRES_USER=routesync
POSTGRES_PASSWORD=change-me
POSTGRES_DB=routesync
POSTGRES_PORT=5432

# Used by the PostgreSQL MCP server (Claude Code), which runs in Docker: host.docker.internal reaches the host port.
DATABASE_URI=postgresql://routesync:change-me@host.docker.internal:5432/routesync
